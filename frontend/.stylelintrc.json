{
  "rules": {
    "declaration-property-value-disallowed-list": {
      "/^color$|^background|^border.*color$|^fill$|^stroke$|^outline-color$/": [
        "/#[0-9a-fA-F]{3,8}/",
        "/\\brgba?\\(\\s*\\d/",
        "/\\bhsla?\\(/"
      ],
      "font-size": [
        "/^\\d/",
        "/^clamp\\(/",
        "/^calc\\(/"
      ],
      "font-family": [
        "/^(?!var\\()/"
      ],
      "line-height": [
        "/^\\d*\\.?\\d+$/"
      ],
      "letter-spacing": [
        "/em$|px$/"
      ],
      "/^(?!transform$|outline-offset$).+$/": [
        "/(^|[^0-9a-zA-Z.-])-?([4-9]|[1-9][0-9]+)(\\.[0-9]+)?px\\b/",
        "/[0-9]v(w|min|max)\\b/",
        "/(^|[\\s(,])clamp\\(/"
      ]
    },
    "declaration-property-value-allowed-list": {
      "border-radius": [
        "/var\\(--asc-radius/",
        "/var\\(--asc-card-radius\\)/",
        "0",
        "50%"
      ]
    },
    "media-feature-name-value-allowed-list": {
      "/^(min|max)-width$/": ["560px", "768px", "1024px", "1200px"]
    },
    "custom-property-pattern": "^asc-[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "ignoreFiles": ["**/tokens.css", "**/node_modules/**", "**/dist/**"]
}
